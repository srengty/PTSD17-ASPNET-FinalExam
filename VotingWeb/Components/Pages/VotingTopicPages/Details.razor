@page "/votingtopics/details"
@using Microsoft.EntityFrameworkCore
@using VotingWeb.Models
@inject VotingWeb.Data.ApplicationDbContext context
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>VotingTopic</h2>
    <hr />
    @if (votingtopic is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@votingtopic.Title</dd>
            <dt class="col-sm-2">TitleImage</dt>
            <dd class="col-sm-10">@votingtopic.TitleImage</dd>
            <dt class="col-sm-2">Answers</dt>
            <dd class="col-sm-10">@votingtopic.Answers</dd>
        </dl>
        <div>
            <a href="@($"/votingtopics/edit?id={votingtopic.Id}")">Edit</a> |
            <a href="@($"/votingtopics")">Back to List</a>
        </div>
    }
</div>

@code {
    private VotingTopic? votingtopic;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        votingtopic = await context.VotingTopics.FirstOrDefaultAsync(m => m.Id == Id);

        if (votingtopic is null)
        {
            NavigationManager.NotFound();
        }
    }
}
