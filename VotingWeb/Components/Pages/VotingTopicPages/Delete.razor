@page "/votingtopics/delete"
@using Microsoft.EntityFrameworkCore
@using VotingWeb.Models
@inject VotingWeb.Data.ApplicationDbContext context
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>VotingTopic</h2>
    <hr />
    @if (votingtopic is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@votingtopic.Title</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">TitleImage</dt>
            <dd class="col-sm-10">@votingtopic.TitleImage</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Answers</dt>
            <dd class="col-sm-10">@votingtopic.Answers</dd>
        </dl>
        <EditForm method="post" Model="votingtopic" OnValidSubmit="DeleteVotingTopic" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(votingtopic is null)">Delete</button> |
            <a href="/votingtopics">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private VotingTopic? votingtopic;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        votingtopic = await context.VotingTopics.FirstOrDefaultAsync(m => m.Id == Id);

        if (votingtopic is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteVotingTopic()
    {
        context.VotingTopics.Remove(votingtopic!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/votingtopics");
    }
}
